@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@OPENCAGD_ENABLE_MPI@)
    find_dependency(MPI COMPONENTS CXX)
endif()
if(@OPENCAGD_ENABLE_PLOT@ AND NOT @BUILD_SHARED_LIBS@)
    find_dependency(Python3 COMPONENTS Interpreter Development)
endif()
if(@OPENCAGD_ENABLE_VTK@ AND NOT @BUILD_SHARED_LIBS@)
    find_dependency(VTK 9.4 COMPONENTS
        CommonCore CommonDataModel FiltersCore FiltersSources
        InteractionStyle IOImage RenderingCore RenderingOpenGL2 RenderingAnnotation)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OpenCAGDTargets.cmake")
check_required_components(OpenCAGD)
